### 1. v1 Ticket endpoint without token returns 401
GET http://localhost:8080/api/v1/tickets

> {%
    client.test("v1 Access without token should be unauthorized", function() {
        client.assert(response.status === 401, "Expected 401 Unauthorized");
    });
%}

### 2. Login to get a valid token (Reuses your login logic)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "maya.doe@company.com",
  "password": "Password123"
}


> {%
    client.test("Login successful", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.global.set("user_token", response.body.token);
%}

### 3. v1 Ticket endpoint works with a valid token
GET http://localhost:8080/api/v1/tickets
Authorization: Bearer {{user_token}}

> {%
    client.test("v1 Access with token should be successful", function() {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 4. Legacy /api/tickets endpoint still works
GET http://localhost:8080/api/tickets
Authorization: Bearer {{user_token}}

> {%
    client.test("Legacy access should still be supported", function() {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

